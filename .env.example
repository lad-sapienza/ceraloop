# Directus Backend Configuration
# Replace with your Directus instance URL (include trailing slash)
VITE_DIRECTUS_URL="https://your-directus-instance.com/"

# Default Directus Role assigned to newly registered users (UUID)
# Note: For best security, set this as a server-side Preset on the users collection instead of relying on the client.
# If you still need the client fallback, set the UUID here.
VITE_DIRECTUS_DEFAULT_ROLE="00000000-0000-0000-0000-00000000"

# Collection Names Configuration
# These variables allow you to customize the Directus collection names used by CeraLoop.
# This enables multi-project deployments, A/B testing, or adapting to different artifact types.
# If not set, the application will use the default collection names shown below.

# Main collection storing model output and evaluation items
# VITE_COLLECTION_MODEL_OUTPUT="model_output"

# Collection storing user feedback/evaluations
# VITE_COLLECTION_USER_FEEDBACKS="user_feedbacks"

# Collection storing additional user profile information
# VITE_COLLECTION_USER_INFORMATION="user_information"

# Directus system users collection
# VITE_COLLECTION_USERS="directus_users"

# Directus system files collection
# VITE_COLLECTION_FILES="directus_files"
